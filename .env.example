# ==============================================================================
# VARIABLES DE ENTORNO: CATÁLOGO WEB & SANITY STUDIO
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo a '.env.local' para desarrollo en tu PC.
# 2. En Vercel, agrega estas variables en: Project Settings -> Environment Variables.
# ==============================================================================

# 1. Identificador de Proyecto de Sanity (Costo $0 de por vida)
# Para obtenerlo en 2 minutos:
# a) Ingresa a https://sanity.io y crea una cuenta gratis con Google o GitHub.
# b) Ve a https://sanity.io/manage y haz clic en "Create Project" (Nombre: Catalogo).
# c) Copia el "Project ID" y pégalo aquí abajo:
NEXT_PUBLIC_SANITY_PROJECT_ID=tu_project_id_aqui

# 2. Nombre del Dataset (Por defecto siempre es 'production')
NEXT_PUBLIC_SANITY_DATASET=production

# 3. Versión de la API de Sanity (Formato YYYY-MM-DD)
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# 4. (Opcional) URL pública del catálogo, usada en los enlaces de WhatsApp y al compartir.
#    Solo hace falta si usas un dominio propio: en Vercel y Netlify se detecta sola.
# NEXT_PUBLIC_SITE_URL=https://mitienda.com

# ==============================================================================
# IMPORTANTE: CONFIGURACIÓN DE CORS EN SANITY
# ==============================================================================
# Para que tu panel de administración (/admin) y el catálogo puedan consultar datos:
# 1. Ve a https://sanity.io/manage -> Tu Proyecto -> Pestaña "API".
# 2. En "CORS Origins", haz clic en "Add CORS origin" y agrega:
#    - http://localhost:3000 (marca la casilla "Allow credentials")
#    - https://tu-catalogo.vercel.app (marca la casilla "Allow credentials")
# ==============================================================================
